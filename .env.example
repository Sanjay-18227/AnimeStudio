# ========================================================
# ANIME STUDIO AI - ENVIRONMENT CONFIGURATION (.env)
# ========================================================
# All features have free-tier or open-source defaults.
# Configure the API keys below to unlock cloud AI inference.
# ========================================================

# Application Settings
ENVIRONMENT=development
PORT=8000
HOST=127.0.0.1
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --------------------------------------------------------
# 1. TEXT AI PROVIDERS (Brainstorming, Script, Dialogue)
# --------------------------------------------------------
# Google Gemini API (Recommended Free Tier)
# Get a free key at: https://aistudio.google.com/
GEMINI_API_KEY=
DEFAULT_GEMINI_MODEL=gemini-1.5-flash

# OpenRouter Free Tier (Llama 3.3 70B, Qwen, Mistral free variants)
# Get a free key at: https://openrouter.ai/
OPENROUTER_API_KEY=
DEFAULT_OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Default Active Text Provider: "gemini" | "openrouter" | "mock"
ACTIVE_TEXT_PROVIDER=gemini

# --------------------------------------------------------
# 2. IMAGE AI PROVIDERS (Anime Images, Characters, Panels)
# --------------------------------------------------------
# Hugging Face Free Inference API
# Get a free token at: https://huggingface.co/settings/tokens
HUGGINGFACE_API_TOKEN=
HF_IMAGE_MODEL=stabilityai/stable-diffusion-xl-base-1.0
HF_ANIME_MODEL=cagliostrolab/animagine-xl-3.1

# Cloudflare Workers AI (Free 10,000 neurons/day tier)
# https://dash.cloudflare.com/
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CF_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell

# Default Active Image Provider: "huggingface" | "cloudflare" | "mock"
ACTIVE_IMAGE_PROVIDER=huggingface

# --------------------------------------------------------
# 3. VIDEO AI & PROCESSING PROVIDERS
# --------------------------------------------------------
# Local FFmpeg executable path (leave blank to search system PATH)
FFMPEG_PATH=
# Optional AI Video Generation API (e.g. Wan 2.1 via HF Spaces or replicate/adapter)
VIDEO_PROVIDER_API_KEY=
ACTIVE_VIDEO_PROVIDER=ffmpeg_composer

# --------------------------------------------------------
# 4. TEXT-TO-SPEECH (TTS) & VOICE PROVIDERS
# --------------------------------------------------------
# Free Edge TTS (Microsoft Neural Voices, supports English & Tamil)
ENABLE_EDGE_TTS=true
DEFAULT_VOICE_EN=en-US-ChristopherNeural
DEFAULT_VOICE_TA=ta-IN-PallaviNeural

# --------------------------------------------------------
# 5. DATABASE CONFIGURATION
# --------------------------------------------------------
# Local SQLite (Default)
DATABASE_URL=sqlite:///./anime_studio.db

# Optional Supabase / PostgreSQL Connection
# DATABASE_URL=postgresql://user:password@db.supabase.co:5432/postgres
